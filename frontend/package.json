{
  "name": "venusfactory-webui-v2",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/copy-public-to-assets.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "test": "node --import ./tests/register-ts.mjs --test tests/*.test.mjs",
    "prebuild": "python ../scripts/sync_platform_docs.py --check"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "molstar": "^5.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  },
  "scarfSettings": {
    "enabled": false
  }
}

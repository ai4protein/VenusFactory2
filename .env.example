# ===================== Core Runtime (required/recommended) =====================
# [required for online deploy] Runtime mode: local | online
WEBUI_V2_MODE=local
# [online + kimi-code] How to spawn per-session kimi daemons:
#   auto     = sandbox (sudo) → bwrap (no sudo) → user
#   sandbox  = venus-spawn-kimi + sudo DynamicUser (setup-online-mode.sh)
#   bwrap    = bubblewrap user-namespace sandbox (no sudo; needs bwrap)
#   user     = same-user child process (no OS isolation; last resort)
# KIMI_ONLINE_SPAWN_MODE=auto
# [recommended] API server bind and logging for WebUI v2
WEBUI_V2_HOST=0.0.0.0
WEBUI_V2_PORT=7861
WEBUI_V2_LOG_LEVEL=info
# [optional] Canonical external origin when HTTPS terminates before the API.
# Use the exact public origin, e.g. https://venusfactory.example; no path or wildcard.
WEBUI_V2_PUBLIC_ORIGIN=
# [online only] Public GA4 measurement ID (G-...), not an API secret. Empty disables tracking.
# Also editable under Administration > Environment; restart the API after changes.
WEBUI_V2_GA_MEASUREMENT_ID=
# [recommended] Frontend serving mode
WEBUI_V2_FRONTEND_DIST=frontend/dist
WEBUI_V2_DEV_MODE=0
# Automatically started worker pools retire after this many idle seconds.
# Service-managed pools (VENUS_WORKER_AUTOSTART=0) remain running.
VENUS_WORKER_IDLE_TIMEOUT=60
WEBUI_V2_FRONTEND_DEV_URL=http://127.0.0.1:5173
# [optional] Comma-separated CORS allowlist
WEBUI_V2_CORS_ORIGINS=http://127.0.0.1:7861,http://localhost:7861,http://127.0.0.1:5173,http://localhost:5173
# [optional; security-sensitive] Allow non-localhost access to /api/settings/env
WEBUI_V2_ALLOW_REMOTE_SETTINGS=0


# ===================== LLM / AI Keys =====================
# Free routes and their defaults remain in the server-owned catalog.
# Official APIs below are opt-in for LOCAL mode only. Restart services after editing.
DMXAPI_API_KEY=
OPENROUTER_API_KEY=
VENUS_EXECUTION_CATALOG=configs/harness/free_execution_catalog.json

# Report / legacy chat defaults (model-config.yaml uses DMXAPI_API_KEY).
CHAT_MODEL_NAME=glm-4-flash
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=4096
CHAT_CODE_MAX_TOKENS=4096
# CHAT_API_KEY is a legacy override; normally leave it unset.
# Leave CHAT_BASE_URL unset so it does not override another provider's route.
# Configure a key AND an exact model ID from your provider console.
# MODEL is a single ID; MODELS optionally adds comma-separated IDs.
# No model is selected automatically and no paid fallback is enabled.
# See docs/model-providers.md for setup, compatibility and regional endpoints.

# ===================== OpenAI / ChatGPT API (local) =====================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODELS=
OPENAI_CONTEXT_TOKENS=131072
OPENAI_MAX_OUTPUT_TOKENS=4096

# ===================== Anthropic / Claude API (local) =====================
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
ANTHROPIC_CONTEXT_TOKENS=131072
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# ===================== xAI / Grok API (local) =====================
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_MODELS=
XAI_CONTEXT_TOKENS=131072
XAI_MAX_OUTPUT_TOKENS=4096

# ===================== Zhipu / GLM API (local) =====================
GLM_API_KEY=

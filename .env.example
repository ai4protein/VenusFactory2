# [Claude optional] Only needed for keys not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# [optional] LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=venusfactory


# ===================== Search / External APIs =====================
# [conditional] Required for corresponding tools only
TAVILY_API_KEY=
SERP_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
FDA_API_KEY=
BRENDA_EMAIL=
BRENDA_PASSWORD=

# ===================== Agent Behavior =====================
# [optional] Search fan-out / reasoning retries / tool timeout
SEARCH_MAX_RESULTS=3
MAX_STEP_RETRIES=2
TOOL_EXECUTION_TIMEOUT=600


# ===================== Researcher =====================
# Total LLM requests per NEW report, including specialists, review and repair (1-96).
# Existing report checkpoints retain their original ceiling. Lower settings cap resumed work.
VENUS_REPORT_MODEL_CALL_LIMIT=48
# Optional free catalog model ID for source review; blank reuses the writing model. New reports only.
VENUS_REPORT_REVIEWER_MODEL_ID=

# ===================== WebUI V2 Limits (mode-based) =====================
# [online only] Max FASTA record count per run in Quick/Advanced
WEBUI_V2_ONLINE_FASTA_LIMIT=50
# [online only] Max designed sequences per Sequence Design run
WEBUI_V2_ONLINE_SEQUENCE_DESIGN_LIMIT=50
# [online only] New conversations per browser visitor per day, shared across all three modes.
# Minimum 1; existing conversations do not spend another credit. Shared IPs have separate balances.
WEBUI_V2_ONLINE_DAILY_CHAT_LIMIT=3
# Per-browser daily online compute budgets; local mode remains unlimited.
WEBUI_V2_ONLINE_DAILY_PREDICTION_LIMIT=20
# Shared networks retain individual daily balances; this only limits bursts.
VENUS_ONLINE_IP_COMPUTE_STARTS_PER_MINUTE=30
# [online only] Independent IP burst protection: maximum new conversations in a rolling minute.
VENUS_ONLINE_IP_STARTS_PER_MINUTE=30
VENUS_QUOTA_TIMEZONE=Asia/Shanghai
# [proxy deployments] Comma-separated CIDRs of trusted reverse proxies; leave blank for direct access.
# The proxy must overwrite/append X-Forwarded-For. Never trust arbitrary client headers.
# Example for a same-host reverse proxy only: 127.0.0.1/32,::1/128
VENUS_TRUSTED_PROXIES=
# [online only] Session token TTL and signing secret
WEBUI_V2_SESSION_TOKEN_TTL_HOURS=24
WEBUI_V2_SESSION_TOKEN_SECRET=
# Download batch caps
# [local] 0 means unlimited
WEBUI_V2_LOCAL_DOWNLOAD_BATCH_LIMIT=0
# [online] hard cap
WEBUI_V2_ONLINE_DOWNLOAD_BATCH_LIMIT=50

# ===================== Storage / Temp Outputs =====================
# [recommended] Root for generated artifacts
TEMP_OUTPUTS_DIR=temp_outputs
# [optional] TTL cleanup switches
TEMP_OUTPUTS_ENABLE_TTL_CLEANUP=0
TEMP_OUTPUTS_UPLOADS_TTL_DAYS=7
TEMP_OUTPUTS_WORK_TTL_DAYS=2
TEMP_OUTPUTS_RESULTS_TTL_DAYS=14
TEMP_OUTPUTS_SESSIONS_TTL_DAYS=3
TEMP_OUTPUTS_MANIFESTS_TTL_DAYS=30
TEMP_OUTPUTS_CACHE_TTL_DAYS=7
# Legacy fallback key used by some cleanup paths
TEMP_OUTPUTS_AGENT_TTL_DAYS=3


# ===================== MCP / Remote / DrugSDA =====================
# [recommended] MCP server bind
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8081
# [conditional] Remote structure backend (pjlab) credentials and endpoints
SCP_HUB_API_KEY=
ESMFOLD_BACKEND=local
SCP_WORKFLOW_SERVER_URL=http://115.190.136.251:8080/mcp
DRUGSDA_MODEL_SERVER_URL=https://scp.intern-ai.org.cn/api/v1/mcp/2/DrugSDA-Tool
DRUGSDA_TOOL_SERVER_URL=https://scp.intern-ai.org.cn/api/v1/mcp/2/DrugSDA-Tool
# Optional MMseqs DB paths for discovery-related features
VENUSMINE_MMSEQS_DATABASE_PATH=
MMSEQS_DATABASE_PATH=

# ===================== Hugging Face / Data =====================
# [optional] Mirror for model downloads
HF_ENDPOINT=https://hf-mirror.com
# [optional] Sequence model cache root
PT_DATA_DIR=

# ===================== Checkpoint Hub =====================
# Finetuned / ProteinMPNN weights: https://huggingface.co/AI4Protein/VenusFactory2-ckpts
# Manual: python scripts/download_ckpts.py --preset predict-core
VENUS_CKPT_REPO_ID=AI4Protein/VenusFactory2-ckpts
VENUS_CKPT_DIR=ckpt
VENUS_CKPT_REVISION=main
# [recommended] Auto-fetch missing weights on first use (set 0 for air-gapped)
VENUS_CKPT_AUTO_DOWNLOAD=1
# [optional] Suppress download notices / progress text (CI)
# VENUS_DOWNLOAD_QUIET=0

# ===================== Legacy / Compatibility (optional) =====================
# Legacy env names retained for backward notes (may be unused in v2 runtime):
# AGENT_DEFAULT_BACKEND=local
# GRADIO_BASE_URL=http://localhost:7860/

# ===================== Logging =====================
# [optional] Global log level: DEBUG | INFO | WARNING | ERROR
VENUS_LOG_LEVEL=INFO
# [optional] Log format: text | json
VENUS_LOG_FORMAT=text

# ===================== Analytics (optional) =====================
# [optional] Analytics SQLite database path
WEBUI_V2_ANALYTICS_DB_PATH=
# [optional] GeoIP MaxMind MMDB path for IP geolocation
WEBUI_V2_GEOIP_MMDB_PATH=
# [optional] Token pricing JSON, e.g. {"gpt-4": 0.03}
WEBUI_V2_TOKEN_PRICE_JSON=

# ===================== Advanced Debug (optional) =====================
BRENDA_DEBUG=

# ===================== Docker / Build =====================
VENUS_FACTORY_VERSION_NUMBER=
# e.g. cpu, cu128
VENUS_FACTORY_CUDA_VARIANT=
VENUS_FEEDBACK_WEBHOOK_URL=
# [optional] Webhook signature secret for feedback verification
VENUS_FEEDBACK_WEBHOOK_SECRET=

# ==================== Agent Context ====================
# Automatic working-memory compaction; original chat records are retained.
# Text token estimates are conservative. Native instructions/tools use reserved model capacity.
WEBUI_V2_AGENT_CONTEXT_TOKENS=32000
WEBUI_V2_AGENT_RECENT_TURNS=8
WEBUI_V2_AGENT_COMPACT_PERCENT=80
WEBUI_V2_AGENT_SUMMARY_TOKENS=2000
# 0 means unlimited user turns; retrying a turn does not spend another turn.
WEBUI_V2_AGENT_MAX_TURNS=0

# === Session sandbox resource admission (shared by local and online) ===
# Empty root uses runtime/control/sandboxes; all instances on one host should share it.
VENUS_SANDBOX_CONTROL_ROOT=
VENUS_SANDBOX_MAX_PARALLEL=2
VENUS_SANDBOX_TOTAL_MEMORY_MB=16384
VENUS_SANDBOX_ONLINE_MEMORY_MB=2048
VENUS_SANDBOX_LOCAL_MEMORY_MB=8192
VENUS_SANDBOX_MEMORY_RESERVE_MB=4096
VENUS_SANDBOX_DISK_RESERVE_MB=2048
VENUS_SANDBOX_WAIT_SECONDS=60

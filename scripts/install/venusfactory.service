[Unit]
Description=VenusFactory2 online API, MCP and worker services
Documentation=https://github.com/ai4protein/VenusFactory2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user, root and interpreter to your installation before enabling.
User=venus
Group=venus
WorkingDirectory=/opt/venusfactory
Environment=WEBUI_V2_MODE=online
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/venusfactory/.venv/bin/python scripts/serve.py --mode online --host 127.0.0.1 --port 7861
Restart=on-failure
RestartSec=5s
TimeoutStopSec=60s
KillMode=mixed
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

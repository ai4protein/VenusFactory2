# Optional overrides. Defaults support a single-server research deployment.
# The default queue directory is private and scoped to this repository path.
# Set VENUS_JOB_QUEUE_ROOT only when all web and worker processes share that path.
# The launcher appends local/online to this repository-relative base.
VENUS_RUNTIME_ROOT=runtime
VENUS_MODEL_RUNTIMES_CONFIG=configs/model_runtimes.json
# Set to 0 when a service manager runs --component workers separately.
VENUS_WORKER_AUTOSTART=1
VENUS_WORKERS_RESEARCH=2
VENUS_WORKERS_CPU=2
VENUS_WORKERS_GPU=1
VENUS_WORKERS_API=4
VENUS_QUEUE_CPU_SLOTS=2
VENUS_QUEUE_GPU_SLOTS=1
VENUS_QUEUE_RESEARCH_SLOTS=2
# Concurrent requests per provider host; free-model policy is enforced separately.
VENUS_QUEUE_API_SLOTS=2
VENUS_QUEUE_RUNNING_PER_OWNER=2
VENUS_QUEUE_MAX_PENDING=256
VENUS_QUEUE_MAX_PENDING_PER_OWNER=32
# Execution limits start after admission; time spent waiting is excluded.
VENUS_QUEUE_MODEL_TIMEOUT=3600
VENUS_QUEUE_CUSTOM_TIMEOUT=86400
VENUS_QUEUE_RESEARCH_TIMEOUT=2419200

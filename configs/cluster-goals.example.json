  "model_runtimes": null,
  "execution_catalog": null,
  "tool_credential_refs": [],
  "checkpoint_root": null,
  "huggingface_cache": null,
  "scheduler": {
    "backend": "slurm",
    "cluster": "your-cluster",
    "bin_directory": "/usr/bin"
  }

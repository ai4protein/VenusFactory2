{
  "schema": "venusfactory.cluster-config.v1",
  "repository": "..",
  "control_root": "../runtime/local/cluster-goals",
  "python": "../.venv/bin/python",
  "runtime_root": "..",
  "goal_roots": [
    "../runtime/local",
    "../runtime/verification",
    "../research_runs"
  ],
  "env_file": "../.env",
  "extra_python_paths": [],
